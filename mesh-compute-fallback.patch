+	const auto address = [&](uint32_t v4, uint32_t component) {
+		const auto dword = EmitAddU32(
+		    state, EmitBinaryU32(state, spv::OpIMul, v4, ConstantU32(state, 4)),
+		    ConstantU32(state, component));
