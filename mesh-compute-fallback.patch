+			    state, EmitAddU32(state, slot_v4, ConstantU32(state, 1)),
+			    EmitBinaryU32(state, spv::OpIMul, index, ConstantU32(state, layout.vertex_stride)));
+			for (const auto& output: state.outputs) {
